from concurrent.futures import Future
from typing import Any, Callable, Dict, List, Optional, Tuple, Type
import asyncio
from .loggers import ClientLogger, DefaultClientLogger

class Command:
    def __call__(self, *args: Any, **kwargs: Any) -> Any: ...

class Client:
    def __init__(self, server_host: str, server_port: int, *, self_host: Any = ..., self_port: int = ..., frame_type: Any = ..., sync: bool = ..., push_queue_size: int = ..., strict_type_check: bool = ..., logger: Optional[Type[ClientLogger]] = DefaultClientLogger) -> None: ...
    server_host: str
    server_port: int
    self_host: Optional[str]
    self_port: int
    server_address: Tuple[str, int]
    self_address: Tuple[Optional[str], int]
    sync: bool
    strict_type_check: bool
    def __getattr__(self, command: str) -> Command: ...
    def call(self, command: str, *args: Any, **kwargs: Any) -> Any: ...
    def sync_call(self, command: str, *args: Any, **kwargs: Any) -> Any: ...
    def async_call(self, command: str, *args: Any, **kwargs: Any) -> asyncio.Future[Any]: ...
    def submit(self, command: str, *args: Any, **kwargs: Any) -> Future[Any]: ...
    def add_request_callback(self, callback: Any) -> None: ...
    def add_response_callback(self, callback: Any) -> None: ...
    def add_push_callback(self, callback: Any) -> None: ...
    def add_connected_callback(self, callback: Any) -> None: ...
    def add_disconnected_callback(self, callback: Any) -> None: ...
    def add_retry_connect_callback(self, callback: Any) -> None: ...
    def on_request(self, function: Optional[Callable[..., Any]] = ...) -> Callable[..., Any]: ...
    def on_response(self, function: Optional[Callable[..., Any]] = ...) -> Callable[..., Any]: ...
    def on_push(self, function: Optional[Callable[..., Any]] = ...) -> Callable[..., Any]: ...
    def on_connected(self, function: Optional[Callable[..., Any]] = ...) -> Callable[..., Any]: ...
    def on_disconnected(self, function: Optional[Callable[..., Any]] = ...) -> Callable[..., Any]: ...
    def on_retry_connect(self, function: Optional[Callable[..., Any]] = ...) -> Callable[..., Any]: ...
    async def next_push(self) -> Any: ...
    def set_service_definition(self, schema: List[Dict[str, Any]]) -> None: ...
    def connect(self, host: Optional[str] = ..., port: Optional[int] = ..., *, wait: bool = ...) -> Any: ...
    def disconnect(self, *, wait: bool = ...) -> Any: ...
    def wait_for_connected(self) -> Any: ...
    def wait_for_disconnected(self) -> Any: ...
